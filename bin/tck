#!/usr/bin/env bash
#
# Runs the A2A TCK (Technology Compatibility Kit) against a local server.
#
# Upstream replaced its v0.3 suite with the v1.0 compatibility suite, so this
# runs against the v1.0 server, pinned so the gating job is reproducible.
#
# Usage: bin/tck [must|should|may|all]
#
# Prerequisites: uv or pip (Python package manager)

set -euo pipefail

LEVEL="${1:-must}"
PORT="${A2A_TCK_PORT:-9999}"
TCK_DIR=".tck"
# Pinned so a CI run is reproducible and an upstream CLI or layout change
# cannot break this job without a deliberate bump here.
TCK_REF="263b9cfaf16a554bdfb166a7ba5b67716e946349"
SUT_URL="http://localhost:${PORT}"
SERVER_PID=""
BASELINE=""
ACTUAL=""
OUTPUT=""

cleanup() {
  if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "Stopping server (PID $SERVER_PID)..."
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  rm -f "$BASELINE" "$ACTUAL" "$OUTPUT"
}

trap cleanup EXIT

# --- Detect Python tooling ---

if command -v uv &> /dev/null; then
  USE_UV=true
else
  USE_UV=false
  echo "uv not found, falling back to pip"
fi

# --- Clone TCK if needed ---

if [ ! -d "$TCK_DIR" ]; then
  echo "Cloning A2A TCK..."
  git clone https://github.com/a2aproject/a2a-tck.git "$TCK_DIR"
fi

if [ "$(git -C "$TCK_DIR" rev-parse HEAD)" != "$TCK_REF" ]; then
  echo "Checking out A2A TCK $TCK_REF..."
  git -C "$TCK_DIR" fetch origin
  git -C "$TCK_DIR" checkout --detach "$TCK_REF"
fi

# --- Install Python deps ---

echo "Installing TCK dependencies..."
cd "$TCK_DIR"
if [ "$USE_UV" = true ]; then
  uv sync
else
  python3 -m venv .venv 2>/dev/null || true
  .venv/bin/pip install -e .
fi
cd ..

# --- Start Elixir server ---

echo "Starting TCK server on port $PORT..."
A2A_TCK_PORT="$PORT" mix run test/tck/server_v1.exs >/dev/null 2>&1 &
SERVER_PID=$!

# Poll until agent card responds
echo "Waiting for server..."
for i in $(seq 1 30); do
  if curl -sf "${SUT_URL}/.well-known/agent-card.json" > /dev/null 2>&1; then
    echo "Server ready."
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "ERROR: Server process died."
    exit 1
  fi
  sleep 1
done

# Verify server is actually responding
if ! curl -sf "${SUT_URL}/.well-known/agent-card.json" > /dev/null 2>&1; then
  echo "ERROR: Server failed to start within 30 seconds."
  exit 1
fi

# --- Run TCK ---

echo ""
echo "Running TCK (level: $LEVEL)..."
echo "========================================"

# Known failures live in a baseline file rather than being deselected, so a
# fixed gap is as loud as a new regression. The run is red only when the set of
# failing tests differs from the baseline.
BASELINE_FILE="test/tck/expected-failures.txt"
BASELINE="$(mktemp)"
ACTUAL="$(mktemp)"
OUTPUT="$(mktemp)"
# Comments and blank lines are for humans; the comparison sees node ids only.
grep -vE '^\s*(#|$)' "$BASELINE_FILE" | sort -u > "$BASELINE" || true

TCK_ARGS="--sut-host $SUT_URL --transport jsonrpc"
if [ "$LEVEL" != "all" ]; then
  TCK_ARGS="$TCK_ARGS --level $LEVEL"
fi

cd "$TCK_DIR"
TCK_EXIT=0
if [ "$USE_UV" = true ]; then
  uv run ./run_tck.py $TCK_ARGS 2>&1 | tee "$OUTPUT" || TCK_EXIT=$?
else
  .venv/bin/python ./run_tck.py $TCK_ARGS 2>&1 | tee "$OUTPUT" || TCK_EXIT=$?
fi
cd ..

# Anchored to `tests/` so the runner's own "FAILED REQUIREMENTS:" banner,
# which is a section header rather than a node id, is not picked up.
grep -E '^FAILED tests/' "$OUTPUT" | awk '{print $2}' | sort -u > "$ACTUAL" || true

# A non-zero run that produced no FAILED lines is a harness error — the server
# died, the suite could not collect, uv blew up. Never let that look like a
# baseline match.
if [ "$TCK_EXIT" -ne 0 ] && [ ! -s "$ACTUAL" ]; then
  echo ""
  echo "========================================"
  echo "ERROR: TCK exited $TCK_EXIT without reporting any test failures."
  echo "This is a harness failure, not a compliance result."
  exit "$TCK_EXIT"
fi

echo ""
echo "========================================"

if [ "$LEVEL" != "all" ]; then
  echo "Level '$LEVEL' run — baseline is only enforced for 'bin/tck all'."
  echo "$(wc -l < "$ACTUAL" | tr -d ' ') failing test(s)."
  exit "$TCK_EXIT"
fi

if ! diff -q "$BASELINE" "$ACTUAL" > /dev/null 2>&1; then
  echo "TCK results differ from $BASELINE_FILE:"
  echo ""
  comm -13 "$BASELINE" "$ACTUAL" | sed 's/^/  NEW FAILURE:  /'
  comm -23 "$BASELINE" "$ACTUAL" | sed 's/^/  NOW PASSING:  /'
  echo ""
  echo "If a gap is fixed, drop its line from $BASELINE_FILE in the same commit."
  echo "If this is a new regression, fix it — do not add it to the baseline."
  exit 1
fi

echo "TCK run complete — $(wc -l < "$BASELINE" | tr -d ' ') known failure(s), matching $BASELINE_FILE."
exit 0
